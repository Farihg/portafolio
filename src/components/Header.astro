---
// Header component for the portfolio
---

<header class="header">
	<nav class="nav">
		<div class="logo">
			<a href="#hero">Agustín</a>
		</div>
		<div class="theme-toggle" id="theme-toggle">🌙</div>
		<ul class="nav-links" id="nav-links">
			<li><a href="#hero">Inicio</a></li>
			<li><a href="#about">Sobre Mí</a></li>
			<li><a href="#tech-stack">Tecnologías</a></li>
			<li><a href="#projects">Proyectos</a></li>
			<li><a href="#education">Formación</a></li>
			<li><a href="#strengths">Enfoque</a></li>
			<li><a href="#contact">Contacto</a></li>
		</ul>
		<div class="mobile-menu-toggle" id="mobile-menu-toggle">
			<span></span>
			<span></span>
			<span></span>
		</div>
	</nav>
</header>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const toggle = document.getElementById('mobile-menu-toggle');
		const nav = document.getElementById('nav-links');
		const themeToggle = document.getElementById('theme-toggle');
		
		toggle?.addEventListener('click', () => {
			nav?.classList.toggle('active');
			toggle.classList.toggle('active');
		});
		
		// Close menu when clicking a link
		nav?.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', () => {
				nav.classList.remove('active');
				toggle?.classList.remove('active');
			});
		});

		// Theme toggle
		themeToggle?.addEventListener('click', () => {
			const html = document.documentElement;
			const currentTheme = html.classList.contains('dark') ? 'dark' : 'light';
			const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
			html.classList.remove(currentTheme);
			html.classList.add(newTheme);
			localStorage.setItem('theme', newTheme);
			themeToggle.textContent = newTheme === 'dark' ? '🌙' : '☀️';
		});

		// Set initial icon
		const initialTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
		themeToggle.textContent = initialTheme === 'dark' ? '🌙' : '☀️';
	});
</script>

<style>
	.header {
		position: fixed;
		top: 0;
		width: 100%;
		background: var(--header-bg);
		backdrop-filter: blur(10px);
		z-index: 1000;
		padding: 1rem 0;
		border-bottom: 1px solid rgba(74, 222, 128, 0.2);
	}
	.nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}
	.logo a {
		margin: 0;
		font-size: 1.5rem;
		color: var(--logo-text);
		font-weight: 700;
		text-decoration: none;
		transition: color 0.3s;
	}
	.logo a:hover {
		color: var(--header-hover);
	}
	.nav-links {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.nav-links li {
		margin-left: 2rem;
	}
	.nav-links a {
		text-decoration: none;
		color: var(--header-text);
		font-weight: 500;
		transition: color 0.3s;
		font-size: 0.95rem;
	}
	.nav-links a:hover {
		color: var(--header-hover);
	}
	.mobile-menu-toggle {
		display: none;
		flex-direction: column;
		cursor: pointer;
	}
	.mobile-menu-toggle span {
		width: 25px;
		height: 3px;
		background: var(--logo-text);
		margin: 3px 0;
		transition: 0.3s;
	}
	.mobile-menu-toggle.active span:nth-child(1) {
		transform: rotate(-45deg) translate(-5px, 6px);
	}
	.mobile-menu-toggle.active span:nth-child(2) {
		opacity: 0;
	}
	.mobile-menu-toggle.active span:nth-child(3) {
		transform: rotate(45deg) translate(-5px, -6px);
	}
	.theme-toggle {
		cursor: pointer;
		font-size: 1.5rem;
		color: var(--logo-text);
		margin-left: 1rem;
		transition: color 0.3s;
	}
	.theme-toggle:hover {
		color: var(--header-hover);
	}
	@media (max-width: 768px) {
		.nav-links {
			position: fixed;
			top: 100%;
			left: 0;
			width: 100%;
			height: calc(100vh - 80px);
			background: var(--header-bg);
			flex-direction: column;
			justify-content: center;
			align-items: center;
			transform: translateX(-100%);
			transition: transform 0.3s ease;
			z-index: 999;
		}
		.nav-links.active {
			transform: translateX(0);
		}
		.nav-links li {
			margin: 1rem 0;
		}
		.nav-links a {
			font-size: 1.2rem;
		}
		.mobile-menu-toggle {
			display: flex;
		}
	}
</style>
<!-- Header.astro -->