---
// Contact section component
---

<section id="contact" class="contact">
	<div class="contact-bg-particles" aria-hidden="true">
		<div class="particle-contact"></div>
		<div class="particle-contact"></div>
		<div class="particle-contact"></div>
		<div class="particle-contact"></div>
		<div class="particle-contact"></div>
		<div class="particle-contact"></div>
		<div class="particle-contact"></div>
	</div>

<div class="container">
	<h2 class="contact-title">Contacto</h2>

	<div class="contact-content">
		<div class="contact-message">
			<h3 class="message-title">Ponte en contacto</h3>

			<div class="message-content">
				<p>
					Busco oportunidades para integrarme a equipos de desarrollo y participar en
					proyectos digitales con enfoque profesional. Si necesitas un desarrollador con
					organización, criterio técnico y experiencia en tecnologías modernas contactame.
				</p>

				<p>
					Puedes escribirme para presentar propuestas, solicitar información sobre mis
					proyectos o coordinar una conversación profesional.
				</p>
			</div>

			<div class="contact-cta">
				<a href="mailto:aguhfa20@gmail.com" class="cta-button primary">
					<span class="button-text">Enviar correo</span>
					<div class="button-shine"></div>
				</a>

				<a
					href="https://linkedin.com/in/agustin-farias-andres"
					class="cta-button secondary"
					target="_blank"
					rel="noopener noreferrer"
				>
					<span class="button-text">LinkedIn</span>
				</a>
			</div>
		</div>

		<div class="availability-card">
			<h3>Disponible para trabajar</h3>

			<p>
				Actualmente me encuentro buscando oportunidades como desarrollador.
				Me interesa formar parte de equipos donde pueda seguir creciendo
				profesionalmente y aportar soluciones reales.
			</p>

			<div class="skills-grid">
				<div class="skill-item">✓ Frontend Moderno</div>
				<div class="skill-item">✓ Backend y APIs</div>
				<div class="skill-item">✓ Bases de Datos</div>
				<div class="skill-item">✓ Astro y React</div>
				<div class="skill-item">✓ TypeScript</div>
				<div class="skill-item">✓ Trabajo en Equipo</div>
			</div>

			<div class="response-time">
				<span>⚡ Respuesta habitual: dentro de las 24 horas</span>
			</div>
		</div>
	</div>
</div>
</section>

<style>
	.contact {
		padding: 5rem 2rem;
		background:
			linear-gradient(135deg, #0f5132 0%, #14532d 50%, #166534 100%),
			radial-gradient(circle at 30% 20%, rgba(74, 222, 128, 0.1) 0%, transparent 50%),
			radial-gradient(circle at 70% 80%, rgba(34, 197, 94, 0.1) 0%, transparent 50%);
		color: white;
		position: relative;
		overflow: hidden;
	}

	.contact::before {
		content: '';
		position: absolute;
		inset: 0;
		background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="connect" width="30" height="30" patternUnits="userSpaceOnUse"><circle cx="15" cy="15" r="1.5" fill="%234ade80" opacity="0.08"/><line x1="15" y1="15" x2="30" y2="15" stroke="%234ade80" stroke-width="0.8" opacity="0.06"/><line x1="15" y1="15" x2="15" y2="30" stroke="%234ade80" stroke-width="0.8" opacity="0.06"/><circle cx="15" cy="15" r="8" fill="none" stroke="%234ade80" stroke-width="0.3" opacity="0.04"/></pattern></defs><rect width="100" height="100" fill="url(%23connect)"/></svg>');
		pointer-events: none;
		animation: connectPulse 20s ease-in-out infinite;
	}

	@keyframes connectPulse {
		0%,
		100% {
			transform: translate(0, 0) rotate(0deg);
		}
		50% {
			transform: translate(-10px, -5px) rotate(0.5deg);
		}
	}

	.contact-bg-particles {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.particle-contact {
		position: absolute;
		width: 3px;
		height: 3px;
		background: linear-gradient(45deg, #4ade80, #22c55e);
		border-radius: 50%;
		opacity: 0.5;
		animation: particleConnect 14s ease-in-out infinite;
	}

	.particle-contact:nth-child(1) {
		top: 15%;
		left: 10%;
		animation-delay: 0s;
	}

	.particle-contact:nth-child(2) {
		top: 30%;
		right: 20%;
		animation-delay: 2s;
	}

	.particle-contact:nth-child(3) {
		bottom: 40%;
		left: 25%;
		animation-delay: 4s;
	}

	.particle-contact:nth-child(4) {
		top: 65%;
		right: 15%;
		animation-delay: 6s;
	}

	.particle-contact:nth-child(5) {
		bottom: 20%;
		right: 30%;
		animation-delay: 8s;
	}

	.particle-contact:nth-child(6) {
		top: 50%;
		left: 65%;
		animation-delay: 10s;
	}

	.particle-contact:nth-child(7) {
		bottom: 60%;
		left: 75%;
		animation-delay: 12s;
	}

	@keyframes particleConnect {
		0%,
		100% {
			transform: translateY(0px) translateX(0px) scale(1);
			opacity: 0.5;
		}
		50% {
			transform: translateY(-35px) translateX(20px) scale(1.4);
			opacity: 0.9;
		}
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	.contact h2 {
		text-align: center;
		font-size: 2.5rem;
		margin-bottom: 3rem;
		color: #a7f3d0;
		font-weight: 700;
		position: relative;
		animation: titleRise 1s ease-out;
	}

	.contact-title::after {
		content: '';
		position: absolute;
		bottom: -10px;
		left: 50%;
		transform: translateX(-50%);
		width: 120px;
		height: 4px;
		background: linear-gradient(90deg, #4ade80, #22c55e);
		border-radius: 2px;
		animation: lineSweep 1s ease-out 0.5s both;
	}

	@keyframes titleRise {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes lineSweep {
		from {
			width: 0;
		}
		to {
			width: 120px;
		}
	}

	.contact-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		animation: contentSlideUp 1s ease-out 0.3s both;
	}

	@keyframes contentSlideUp {
		from {
			opacity: 0;
			transform: translateY(50px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.contact-message {
		animation: messageSlideLeft 1s ease-out 0.6s both;
	}

	@keyframes messageSlideLeft {
		from {
			opacity: 0;
			transform: translateX(-40px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	.message-title {
		font-size: 1.8rem;
		margin-bottom: 1.5rem;
		color: #d1fae5;
		font-weight: 600;
		position: relative;
	}

	.message-title::before {
		content: '💬';
		position: absolute;
		left: -40px;
		top: 0;
		font-size: 1.5rem;
		opacity: 0.7;
	}

	.message-content {
		margin-bottom: 2rem;
	}

	.contact-message p {
		font-size: 1.1rem;
		line-height: 1.7;
		margin-bottom: 1.5rem;
		color: #e2e8f0;
		padding: 1rem;
		background: rgba(255, 255, 255, 0.03);
		border-left: 3px solid #4ade80;
		border-radius: 0 10px 10px 0;
		transition: background 0.3s ease, transform 0.3s ease;
	}

	.contact-message p:hover {
		background: rgba(255, 255, 255, 0.06);
		transform: translateX(5px);
	}

	.contact-cta {
		display: flex;
		gap: 1rem;
		margin-top: 2rem;
		flex-wrap: wrap;
		animation: ctaBounceIn 1s ease-out 1s both;
	}

	@keyframes ctaBounceIn {
		from {
			opacity: 0;
			transform: translateY(20px) scale(0.9);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	.cta-button {
		display: inline-block;
		padding: 1rem 2rem;
		text-decoration: none;
		border-radius: 50px;
		font-weight: 600;
		transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), background 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		font-size: 1.1rem;
		text-align: center;
		min-width: 180px;
		position: relative;
		overflow: hidden;
		border: 2px solid transparent;
	}

	.cta-button span {
		position: relative;
		z-index: 2;
	}

	.button-shine {
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
		transition: left 0.7s ease;
	}

	.cta-button:hover .button-shine {
		left: 100%;
	}

	.cta-button.primary {
		background: linear-gradient(45deg, #16a34a, #22c55e);
		color: white;
		box-shadow: 0 4px 15px rgba(34, 197, 94, 0.3);
	}

	.cta-button.primary:hover {
		transform: translateY(-3px) scale(1.05);
		box-shadow: 0 8px 25px rgba(34, 197, 94, 0.5);
	}

	.cta-button.secondary {
		background: rgba(255, 255, 255, 0.1);
		color: #a7f3d0;
		border-color: #4ade80;
		backdrop-filter: blur(15px);
	}

	.cta-button.secondary:hover {
		background: rgba(255, 255, 255, 0.2);
		color: white;
		transform: translateY(-2px);
		border-color: #22c55e;
	}



	@media (max-width: 768px) {
		.contact {
			padding: 3rem 1rem;
		}

		.contact-content {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.contact-cta {
			flex-direction: column;
		}

		.cta-button {
			min-width: auto;
		}

		.contact h2 {
			font-size: 2rem;
		}

		.contact-title::after {
			width: 80px;
		}

		.message-title {
			font-size: 1.5rem;
		}

		.message-title::before {
			left: -30px;
		}

		.contact-message p {
			padding: 0.75rem;
		}

		.contact-message p:hover {
			transform: translateX(2px);
		}

		.contact-bg-particles .particle-contact {
			width: 2px;
			height: 2px;
		}
	}
</style>


<!-- Contact.astro -->