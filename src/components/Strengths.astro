---
// Strengths.astro
---

<section id="strengths" class="strengths" aria-labelledby="strengths-title">
	<div class="strengths-bg-particles">
		<div class="particle-strengths"></div>
		<div class="particle-strengths"></div>
		<div class="particle-strengths"></div>
		<div class="particle-strengths"></div>
		<div class="particle-strengths"></div>
		<div class="particle-strengths"></div>
	</div>
	
	<div class="container">
		<div class="section-header">
			<span class="eyebrow">Cómo trabajo</span>
			<h2 id="strengths-title">Mi enfoque profesional</h2>
			<p class="section-description">
				Mi enfoque combina criterio técnico, claridad y resultados sostenibles para cada proyecto.
			</p>
		</div>

		<div class="strengths-content">
			<div class="strengths-text">
				<p>
					Trabajo con un plan claro y foco en los objetivos del proyecto. Busco soluciones 
					mantenibles y alineadas con las necesidades del negocio.
				</p>

				<p>
					Me adapto rápidamente a nuevos desafíos y tecnologías, y valoro la mejora continua
					para optimizar tanto el producto como el proceso de desarrollo.
				</p>

				<p>
					Priorizo la comunicación efectiva, la documentación y las decisiones fundamentadas
					para entregar soluciones de software confiables y de largo plazo.
				</p>
			</div>

			<div class="strengths-visual">
				<div class="strengths-quote">
					<div class="quote-mark" aria-hidden="true">“</div>
					<blockquote>
						Confio en que cada solución debe ser coherente, eficiente y directamente vinculada al problema que resuelve.
					</blockquote>
					<cite></cite>
				</div>

				<div class="values-grid">
					<div class="value-item">
						<div class="value-icon" aria-hidden="true">⚡</div>
						<h3>Proactividad</h3>
						<p>
							Tomo la iniciativa para detectar mejoras y resolver problemas con autonomía.
						</p>
					</div>

					<div class="value-item">
						<div class="value-icon" aria-hidden="true">🔄</div>
						<h3>Adaptabilidad</h3>
						<p>
							Me integro con facilidad a nuevas tecnologías, contextos y dinámicas de
							trabajo.
						</p>
					</div>

					<div class="value-item">
						<div class="value-icon" aria-hidden="true">🎯</div>
						<h3>Enfoque práctico</h3>
						<p>
							Priorizo soluciones concretas, funcionales y alineadas con los objetivos del
							proyecto.
						</p>
					</div>

					<div class="value-item">
						<div class="value-icon" aria-hidden="true">🚀</div>
						<h3>Aprendizaje continuo</h3>
						<p>
							Me mantengo en evolución constante, incorporando nuevas herramientas y buenas
							prácticas.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* --- ESTILOS PRINCIPALES --- */
	.strengths {
		position: relative;
		overflow: hidden;
		padding: 6rem 1.5rem;
		background-color: #0A2E1E; /* Fondo oscuro principal */
		font-family: system-ui, -apple-system, sans-serif;
	}

	/* Gradientes sutiles de fondo */
	.strengths::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 15% 20%, rgba(19, 160, 84, 0.08), transparent 30%),
			radial-gradient(circle at 85% 80%, rgba(168, 231, 204, 0.05), transparent 30%);
		pointer-events: none;
	}

	/* Patrón de cuadrícula de fondo */
	.strengths::after {
		content: "";
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
		background-size: 32px 32px;
		mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1), transparent 85%);
		-webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1), transparent 85%);
		pointer-events: none;
	}

	.container {
		position: relative;
		z-index: 1;
		max-width: 1200px;
		margin: 0 auto;
	}

	/* --- CABECERA DE SECCIÓN --- */
	.section-header {
		max-width: 760px;
		margin: 0 auto 4rem;
		text-align: center;
		animation: headerSlideUp 1s ease-out;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem 1.2rem;
		border-radius: 999px;
		background: rgba(19, 160, 84, 0.1); /* Fondo píldora verde */
		border: 1px solid rgba(19, 160, 84, 0.3);
		backdrop-filter: blur(8px);
		color: #A8E7CC; /* Texto Jade */
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		animation: eyebrowFadeIn 1s ease-out 0.2s both;
	}

	.section-header h2 {
		margin: 1.5rem 0 1rem;
		font-size: clamp(2.5rem, 4vw, 3.2rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: #DAFFF0; /* Título Menta pálido */
		font-weight: 800;
		animation: titleSlideUp 1s ease-out 0.4s both;
	}

	.section-description {
		max-width: 650px;
		margin: 0 auto;
		font-size: 1.15rem;
		line-height: 1.8;
		color: #A9B8AF; /* Texto descriptivo */
		animation: descFadeIn 1s ease-out 0.6s both;
	}

	/* --- CONTENIDO PRINCIPAL --- */
	.strengths-content {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 2.5rem;
		align-items: start;
		animation: contentSlideUp 1s ease-out 0.8s both;
	}

	/* --- TARJETAS (CARDS) --- */
	.strengths-text,
	.strengths-quote,
	.value-item {
		background: rgba(255, 255, 255, 0.03); /* Fondo tipo Glassmorphism oscuro */
		border: 1px solid rgba(168, 231, 204, 0.15); /* Borde sutil Jade */
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: 0 14px 32px rgba(0, 0, 0, 0.2);
		transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	/* Comportamiento Hover general para tarjetas */
	.strengths-text:hover,
	.strengths-quote:hover,
	.value-item:hover {
		background: rgba(255, 255, 255, 0.05);
		border-color: #13A054; /* Borde Acento */
		transform: translateY(-4px);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
	}

	/* --- TEXTO IZQUIERDA --- */
	.strengths-text {
		padding: 2.5rem;
		border-radius: 24px;
	}

	.strengths-text p {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.9;
		color: #A9B8AF;
	}

	.strengths-text p + p {
		margin-top: 1.5rem;
	}

	/* --- COLUMNA DERECHA (VISUAL) --- */
	.strengths-visual {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	/* --- CITA --- */
	.strengths-quote {
		position: relative;
		padding: 2.5rem;
		border-radius: 24px;
		animation: quoteSlideIn 1s ease-out 1s both;
	}

	.quote-mark {
		position: absolute;
		top: 0.5rem;
		left: 1.5rem;
		font-size: 5rem;
		line-height: 1;
		color: rgba(19, 160, 84, 0.15); /* Comilla de fondo sutil */
		font-family: Georgia, serif;
		user-select: none;
	}

	.strengths-quote blockquote {
		position: relative;
		z-index: 1;
		margin: 0 0 1.5rem;
		font-size: 1.2rem;
		line-height: 1.7;
		font-style: italic;
		color: #DAFFF0;
	}

	.strengths-quote cite {
		font-style: normal;
		font-weight: 700;
		font-size: 1.1rem;
		color: #13A054; /* Nombre en color Acento */
	}
	
	.strengths-quote cite::before {
		content: '— ';
	}

	/* --- GRILLA DE VALORES --- */
	.values-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
		animation: gridSlideIn 1s ease-out 1.2s both;
	}

	.value-item {
		padding: 1.5rem;
		border-radius: 20px;
	}

	.value-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		margin-bottom: 1.2rem;
		border-radius: 14px;
		background: rgba(19, 160, 84, 0.1);
		border: 1px solid rgba(19, 160, 84, 0.25);
		font-size: 1.5rem;
		transition: all 0.3s ease;
	}

	.value-item:hover .value-icon {
		transform: scale(1.1) rotate(5deg);
		background: rgba(19, 160, 84, 0.2);
		border-color: #13A054;
	}

	.value-item h3 {
		margin: 0 0 0.75rem;
		font-size: 1.1rem;
		font-weight: 700;
		color: #A8E7CC; /* Sub-títulos Jade */
	}

	.value-item p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: #A9B8AF;
	}

	/* --- PARTÍCULAS ANIMADAS --- */
	.strengths-bg-particles {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
	}

	.particle-strengths {
		position: absolute;
		background: #13A054;
		border-radius: 50%;
		opacity: 0.3;
		animation: floatUp 15s infinite linear;
	}

	.particle-strengths:nth-child(1) { width: 6px; height: 6px; left: 10%; bottom: -10px; animation-duration: 20s; }
	.particle-strengths:nth-child(2) { width: 4px; height: 4px; left: 30%; bottom: -10px; animation-duration: 15s; animation-delay: 2s; }
	.particle-strengths:nth-child(3) { width: 8px; height: 8px; left: 50%; bottom: -10px; animation-duration: 25s; animation-delay: 5s; }
	.particle-strengths:nth-child(4) { width: 5px; height: 5px; left: 70%; bottom: -10px; animation-duration: 18s; animation-delay: 1s; }
	.particle-strengths:nth-child(5) { width: 7px; height: 7px; left: 90%; bottom: -10px; animation-duration: 22s; animation-delay: 4s; }
	.particle-strengths:nth-child(6) { width: 3px; height: 3px; left: 20%; bottom: -10px; animation-duration: 12s; animation-delay: 7s; }

	@keyframes floatUp {
		0% { transform: translateY(0) translateX(0); opacity: 0; }
		10% { opacity: 0.4; }
		90% { opacity: 0.4; }
		100% { transform: translateY(-1000px) translateX(20px); opacity: 0; }
	}

	/* --- ANIMACIONES DE ENTRADA --- */
	@keyframes headerSlideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
	@keyframes eyebrowFadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
	@keyframes titleSlideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
	@keyframes descFadeIn { from { opacity: 0; } to { opacity: 1; } }
	@keyframes contentSlideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
	@keyframes quoteSlideIn { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }
	@keyframes gridSlideIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

	/* --- RESPONSIVE --- */
	@media (max-width: 920px) {
		.strengths-content {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.strengths {
			padding: 4rem 1rem;
		}

		.section-header {
			margin-bottom: 3rem;
		}

		.section-header h2 {
			font-size: 2.2rem;
		}

		.strengths-text,
		.strengths-quote {
			padding: 1.8rem;
		}

		.values-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.strengths-text, .strengths-quote, .value-item { transition: none; }
		.strengths-text:hover, .strengths-quote:hover, .value-item:hover { transform: none; }
		.particle-strengths { display: none; }
		.section-header, .eyebrow, .section-header h2, .section-description, .strengths-content, .strengths-quote, .values-grid {
			animation: none !important;
			opacity: 1 !important;
			transform: none !important;
		}
	}
</style>