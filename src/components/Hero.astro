---
// Hero.astro
---

<section id="hero" class="hero">
	<div class="hero-bg-particles" aria-hidden="true">
		<div class="particle-bg"></div>
		<div class="particle-bg"></div>
		<div class="particle-bg"></div>
		<div class="particle-bg"></div>
		<div class="particle-bg"></div>
	</div>

	<div class="hero-content">
		<div class="hero-text-container">
			<h1 class="hero-name">Agustín Farías</h1>
			<h2 class="hero-title">Desarrollador Full Stack</h2>
			<p class="hero-description">
				Estudiante de Ingeniería en Sistemas de Información en la UTN con título de Analista Desarrollador de Sistemas. Me especializo en diseñar soluciones robustas y escalables, con foco en calidad técnica y resultados relevantes.
			</p>
			<div class="hero-actions">
				<a href="#projects" class="cta-button primary">
					<span class="button-text">Ver proyectos</span>
					<div class="button-glow"></div>
				</a>
				<a href="#contact" class="cta-button secondary">
					<span class="button-text">Contactar</span>
				</a>
			</div>
		</div>

		<div class="hero-visual">
			<div class="code-animation">
				<div class="floating-elements">
					<div class="element java">
						<span class="element-text">Java</span>
					</div>
					<div class="element react">
						<span class="element-text">React</span>
					</div>
					<div class="element node">
						<span class="element-text">Node.js</span>
					</div>
					<div class="element python">
						<span class="element-text">Python</span>
					</div>
					<div class="element typescript">
						<span class="element-text">TypeScript</span>
					</div>
					<div class="element nextjs">
						<span class="element-text">Next.js</span>
					</div>
				</div>
				<div class="connection-lines">
					<svg class="connections" viewBox="0 0 300 300">
						<path d="M50,60 Q150,30 250,60" stroke="rgba(19, 160, 84, 0.3)" stroke-width="2" fill="none"/>
						<path d="M60,180 Q150,150 240,180" stroke="rgba(19, 160, 84, 0.3)" stroke-width="2" fill="none"/>
						<path d="M80,120 Q150,90 220,120" stroke="rgba(19, 160, 84, 0.3)" stroke-width="2" fill="none"/>
					</svg>
				</div>
			</div>
		</div>
	</div>

	<div class="scroll-indicator">
		<div class="scroll-mouse">
			<div class="scroll-wheel"></div>
		</div>
		<p>Desplácese para explorar</p>
	</div>
</section>

<style>
	/* --- ESTILOS PRINCIPALES --- */
	.hero {
		position: relative;
		min-height: 100vh;
		background-color: #0A2E1E; /* Tu verde oscuro principal */
		background-image:
			radial-gradient(circle at 30% 70%, rgba(19, 160, 84, 0.08) 0%, transparent 50%),
			radial-gradient(circle at 70% 30%, rgba(168, 231, 204, 0.05) 0%, transparent 50%);
		overflow: hidden;
		font-family: system-ui, -apple-system, sans-serif;
	}

	/* Patrón de grano sutil */
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="%23DAFFF0" opacity="0.03"/><circle cx="75" cy="75" r="1" fill="%23DAFFF0" opacity="0.02"/><circle cx="50" cy="10" r="0.5" fill="%23DAFFF0" opacity="0.04"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
		pointer-events: none;
		animation: grainMove 20s ease-in-out infinite;
	}

	@keyframes grainMove {
		0%, 100% { transform: translate(0, 0) rotate(0deg); }
		50% { transform: translate(-5px, -5px) rotate(1deg); }
	}

	/* --- PARTÍCULAS --- */
	.hero-bg-particles {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.particle-bg {
		position: absolute;
		width: 4px;
		height: 4px;
		background: #13A054;
		border-radius: 50%;
		opacity: 0.3;
		animation: particleFloat 8s ease-in-out infinite;
	}

	.particle-bg:nth-child(1) { top: 10%; left: 10%; animation-delay: 0s; }
	.particle-bg:nth-child(2) { top: 20%; right: 15%; animation-delay: 2s; }
	.particle-bg:nth-child(3) { bottom: 30%; left: 20%; animation-delay: 4s; }
	.particle-bg:nth-child(4) { top: 60%; right: 10%; animation-delay: 6s; }
	.particle-bg:nth-child(5) { bottom: 20%; right: 25%; animation-delay: 8s; }

	@keyframes particleFloat {
		0%, 100% { transform: translateY(0px) translateX(0px) scale(1); opacity: 0.3; }
		50% { transform: translateY(-20px) translateX(15px) scale(1.2); opacity: 0.6; }
	}

	/* --- CONTENIDO PRINCIPAL --- */
	.hero-content {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem; /* Centrado vertical con min-height */
		min-height: 100vh;
		position: relative;
		z-index: 2;
	}

	.hero-text-container {
		flex: 1;
		animation: slideInLeft 1s ease-out;
		padding-bottom: 4rem; /* Espacio para el indicador de scroll */
	}

	@keyframes slideInLeft {
		from { opacity: 0; transform: translateX(-50px); }
		to { opacity: 1; transform: translateX(0); }
	}

	/* --- TEXTOS --- */
	.hero-name {
		font-size: clamp(3rem, 5vw, 4.5rem);
		margin-bottom: 0.5rem;
		/* Gradiente de Menta Pálido a Blanco puro */
		background: linear-gradient(45deg, #DAFFF0, #ffffff, #A8E7CC, #DAFFF0);
		background-size: 300% 300%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		font-weight: 800;
		letter-spacing: -0.02em;
		animation: gradientShift 4s ease-in-out infinite, textPulse 3s ease-in-out infinite;
		filter: drop-shadow(0 0 15px rgba(218, 255, 240, 0.2));
	}

	@keyframes textPulse {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.01); }
	}

	@keyframes gradientShift {
		0% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
		100% { background-position: 0% 50%; }
	}

	.hero-title {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin-bottom: 1.5rem;
		color: #A8E7CC; /* Sub-título Jade */
		font-weight: 400;
		animation: fadeInUp 1s ease-out 0.3s both;
		position: relative;
		padding-bottom: 10px;
	}

	.hero-title::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 70px;
		height: 4px;
		background: #13A054; /* Acento */
		border-radius: 2px;
		animation: lineGrow 1s ease-out 0.8s both;
	}

	.hero-description {
		font-size: 1.15rem;
		line-height: 1.7;
		margin-bottom: 2.5rem;
		color: #A9B8AF; /* Texto descriptivo */
		max-width: 580px;
		animation: fadeInUp 1s ease-out 0.6s both;
	}

	@keyframes fadeInUp {
		from { opacity: 0; transform: translateY(30px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes lineGrow {
		from { width: 0; }
		to { width: 70px; }
	}

	/* --- BOTONES (ACTUALIZADOS A ESTILO CONTACTO) --- */
	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		animation: fadeInUp 1s ease-out 0.9s both;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.9rem 2rem;
		text-decoration: none;
		border-radius: 99px; /* Forma de píldora */
		font-weight: 600;
		font-size: 1rem;
		transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		position: relative;
		overflow: hidden;
	}

	.cta-button span {
		position: relative;
		z-index: 2;
	}

	.button-glow {
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
		transition: left 0.7s ease;
	}

	.cta-button:hover .button-glow { left: 100%; }

	.cta-button.primary {
		background: #13A054;
		color: #DAFFF0;
		border: 1px solid #13A054;
		box-shadow: 0 10px 20px -5px rgba(19, 160, 84, 0.4);
	}

	.cta-button.primary:hover {
		transform: translateY(-3px) scale(1.05);
		box-shadow: 0 15px 25px -5px rgba(19, 160, 84, 0.6);
	}

	.cta-button.secondary {
		background: rgba(19, 160, 84, 0.1);
		color: #A8E7CC;
		border: 1px solid rgba(19, 160, 84, 0.3);
		backdrop-filter: blur(10px);
	}

	.cta-button.secondary:hover {
		background: rgba(19, 160, 84, 0.2);
		color: #DAFFF0;
		border-color: #13A054;
		transform: translateY(-2px);
	}

	/* --- VISUAL (TAGS FLOTANTES) --- */
	.hero-visual {
		flex: 1;
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: 2;
		animation: slideInRight 1s ease-out 0.5s both;
		padding-bottom: 4rem;
	}

	@keyframes slideInRight {
		from { opacity: 0; transform: translateX(50px); }
		to { opacity: 1; transform: translateX(0); }
	}

	.code-animation {
		position: relative;
		width: 350px;
		height: 350px;
	}

	.floating-elements {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.element {
		position: absolute;
		padding: 0.6rem 1.2rem;
		background: rgba(19, 160, 84, 0.1); /* Fondo translúcido esmeralda */
		border: 1px solid rgba(19, 160, 84, 0.3);
		border-radius: 99px;
		color: #A8E7CC;
		font-weight: 600;
		font-size: 0.9rem;
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		transition: all 0.3s ease;
		cursor: default;
	}

	.element:hover {
		transform: scale(1.1) !important;
		background: rgba(19, 160, 84, 0.2);
		border-color: #13A054;
		color: #DAFFF0;
		box-shadow: 0 10px 25px rgba(19, 160, 84, 0.3);
	}

	.element.java { top: 15%; left: 5%; animation: float 6s ease-in-out infinite; animation-delay: 0s; }
	.element.react { top: 65%; right: 10%; animation: float 6s ease-in-out infinite; animation-delay: 1.5s; }
	.element.node { bottom: 15%; left: 15%; animation: float 6s ease-in-out infinite; animation-delay: 3s; }
	.element.python { top: 35%; right: 0%; animation: float 6s ease-in-out infinite; animation-delay: 4.5s; }
	.element.typescript { top: 50%; left: 10%; animation: float 6s ease-in-out infinite; animation-delay: 2s; }
	.element.nextjs { bottom: 35%; right: 20%; animation: float 6s ease-in-out infinite; animation-delay: 5.5s; }

	@keyframes float {
		0%, 100% { transform: translateY(0px) rotate(0deg); }
		50% { transform: translateY(-15px) rotate(2deg); }
	}

	.connection-lines {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.connections path {
		stroke-dasharray: 5, 5;
		animation: dashFlow 4s linear infinite;
	}

	@keyframes dashFlow { to { stroke-dashoffset: -10; } }

	/* --- INDICADOR DE SCROLL --- */
	.scroll-indicator {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		text-align: center;
		color: #A9B8AF;
		animation: bounce 2s ease-in-out infinite;
		font-size: 0.9rem;
	}

	@keyframes bounce {
		0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
		40% { transform: translateX(-50%) translateY(-10px); }
		60% { transform: translateX(-50%) translateY(-5px); }
	}

	.scroll-mouse {
		width: 24px;
		height: 38px;
		border: 2px solid #13A054;
		border-radius: 12px;
		margin: 0 auto 0.5rem;
		position: relative;
		background: rgba(10, 46, 30, 0.5); /* Sutil fondo para que no se pierda */
	}

	.scroll-wheel {
		width: 4px;
		height: 8px;
		background: #DAFFF0;
		border-radius: 2px;
		position: absolute;
		top: 6px;
		left: 50%;
		transform: translateX(-50%);
		animation: scroll 2s ease-in-out infinite;
	}

	@keyframes scroll {
		0% { opacity: 1; transform: translateX(-50%) translateY(0); }
		100% { opacity: 0; transform: translateX(-50%) translateY(12px); }
	}

	/* --- RESPONSIVE --- */
	@media (max-width: 992px) {
		.hero-content {
			flex-direction: column;
			text-align: center;
			padding-top: 120px;
			justify-content: center;
		}
		
		.hero-text-container {
			padding-bottom: 2rem;
		}

		.hero-title::after {
			left: 50%;
			transform: translateX(-50%);
		}

		.hero-description {
			margin-left: auto;
			margin-right: auto;
		}

		.hero-actions {
			justify-content: center;
		}
		
		.hero-visual {
			padding-bottom: 6rem; /* Dejar espacio para scroll en móviles si entra */
		}
	}

	@media (max-width: 768px) {
		.code-animation {
			width: 280px;
			height: 280px;
		}
		
		.scroll-indicator {
			display: none; /* En celular el scroll es obvio, ahorra espacio visual */
		}

		.element {
			padding: 0.5rem 1rem;
			font-size: 0.8rem;
		}
		
		.cta-button {
			width: 100%;
			max-width: 300px;
		}
	}
	
	@media (prefers-reduced-motion: reduce) {
		.hero::before, .particle-bg, .hero-name, .hero-title, .hero-title::after, 
		.hero-description, .hero-actions, .hero-visual, .element, .connections path, 
		.scroll-indicator, .scroll-wheel, .hero-text-container {
			animation: none !important;
			transform: none !important;
			opacity: 1 !important;
		}
	}
</style>