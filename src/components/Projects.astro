---
// Importar imágenes directamente
import petlifeImage from '../data/petlife.png';
import viajecitoImage from '../data/favicon.png'; // Asumo que es la imagen para Tu Viajecito

const projects = [
	{
		title: "Tu Viajecito",
		tags: ["Web App", "Full Stack", "Next"],
		description:
			"Plataforma para planificar viajes con listas de tareas personalizadas y flujos intuitivos de usuario.",
		details:
			"Diseñé e implementé la solución completa: frontend con React/Next.js, backend con API, autenticación con NextAuth y persistencia en PostgreSQL.",
		image: viajecitoImage,
		demo: null,
		repo: null
	},
	{
		title: "Tu PetLife",
		tags: ["Backend", "API", "Seguridad", "Integración"],
		description:
			"Backend para una aplicación de gestión de mascotas, orientado a integraciones de datos y protección de accesos.",
		details:
			"Implementé la lógica de servidor, la autenticación JWT y la conexión con APIs externas y tambien la integracion del backend con el frontend.",
		image: petlifeImage,
		demo:
			"https://www.linkedin.com/feed/update/urn:li:activity:7435141013209399296/",
		repo: null
	}
];
---

<section id="projects" class="projects">
	<div class="container">
		<h2>Proyectos Destacados</h2>
		<p class="projects-intro">Proyectos seleccionados donde implementé soluciones completas y resolví desafíos concretos.</p>
		
		<div class="projects-grid">
			{projects.map((project) => (
				<article class="project-card">
					<div class="project-visual">
						<!-- Contenedor de imagen optimizado -->
						<div class="image-wrapper">
							<img src={project.image.src} alt={project.title} class="project-image" loading="lazy" />
						</div>
						<div class="floating-particles">
							<div class="particle"></div>
							<div class="particle"></div>
							<div class="particle"></div>
						</div>
					</div>
					
					<div class="project-header">
						<h3>{project.title}</h3>
						<div class="project-tags">
							{project.tags.map(tag => <span class="tag">{tag}</span>)}
						</div>
					</div>

					<div class="project-content">
						<p class="description">{project.description}</p>
						<p class="details">{project.details}</p>
					</div>

					<div class="project-links">
						{
							project.demo ? (
								<a
									href={project.demo}
									target="_blank"
									rel="noopener noreferrer"
									class="project-link primary"
								>
									Ver proyecto
								</a>
							) : (
								<button
									type="button"
									class="project-link primary coming-soon-btn"
								>
									Ver proyecto
								</button>
							)
						}
					</div>
				</article>
			))}
		</div>
	</div>

	<!-- Modal Coming Soon -->
	<div id="comingSoonModal" class="coming-soon-modal">
		<div class="coming-soon-content">
			<div class="coming-soon-icon">🚀</div>

			<h3>Demo próximamente</h3>

			<p>
				Este proyecto ya se encuentra desarrollado pero la versión pública
				aún no está disponible.
			</p>

			<p>
				Actualmente estoy trabajando en los últimos detalles antes de su
				publicación.
			</p>

			<button id="closeComingSoon" class="close-modal-btn">
				Entendido
			</button>
		</div>
	</div>
</section>

<style>
	/* --- ESTILOS PRINCIPALES --- */
	.projects { 
		padding: 6rem 2rem; 
		/* NUEVO FONDO: Un tono más profundo para separar secciones (#072215) */
		background-color: #072215; 
		position: relative; 
		overflow: hidden; 
		font-family: system-ui, -apple-system, sans-serif;
	}
	
	.container { 
		max-width: 1200px; 
		margin: 0 auto; 
		position: relative; 
		z-index: 2; 
	}
	
	.projects h2 { 
		text-align: center; 
		font-size: 3rem; 
		margin-bottom: 1rem; 
		font-weight: 800; 
		color: #DAFFF0; /* Título Menta pálido */
	}
	
	.projects h2::after {
		content: '';
		display: block;
		width: 90px;
		height: 4px;
		margin: 14px auto 0;
		border-radius: 999px;
		background: #13A054; /* Acento verde vibrante */
	}
	
	.projects-intro { 
		text-align: center; 
		font-size: 1.1rem; 
		margin-bottom: 4rem; 
		color: #A9B8AF; /* Texto detallado */
		max-width: 700px; 
		margin-left: auto; 
		margin-right: auto; 
		line-height: 1.8;
	}
	
	/* --- GRID Y TARJETAS --- */
	.projects-grid { 
		display: grid; 
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); 
		gap: 2rem; 
	}
	
	.project-card { 
		/* Aumenté levémente la opacidad de la tarjeta para que resalte contra el fondo más oscuro */
		background: rgba(255, 255, 255, 0.04); 
		border: 1px solid rgba(168, 231, 204, 0.15); /* Borde sutil Jade */
		border-radius: 24px; 
		padding: 1.5rem; 
		display: flex;
		flex-direction: column;
		transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
		position: relative;
	}
	
	.project-card:hover { 
		transform: translateY(-8px); 
		border-color: #13A054; 
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4); /* Sombra un poco más fuerte por el fondo oscuro */
	}

	/* --- IMÁGENES --- */
	.image-wrapper {
		width: 100%;
		height: 220px;
		overflow: hidden;
		border-radius: 16px;
		background-color: rgba(0, 0, 0, 0.25); 
		border: 1px solid rgba(168, 231, 204, 0.05);
		margin-bottom: 1.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.project-image { 
		object-fit: contain; 
		width: 100%;
		height: 100%;
		padding: 1.5rem; 
		transition: transform 0.5s ease;
	}

	.project-card:hover .project-image {
		transform: scale(1.08);
	}

	/* --- CONTENIDO --- */
	.project-header h3 { 
		margin: 0 0 0.75rem 0; 
		font-size: 1.4rem; 
		color: #DAFFF0; 
	}
	
	.project-tags { 
		display: flex; 
		flex-wrap: wrap; 
		gap: 0.5rem; 
		margin-bottom: 1.2rem; 
	}
	
	.tag { 
		background: rgba(19, 160, 84, 0.15); 
		color: #DAFFF0; 
		padding: 0.3rem 0.8rem; 
		border-radius: 12px; 
		font-size: 0.8rem; 
		font-weight: 500; 
		border: 1px solid rgba(19, 160, 84, 0.3);
	}
	
	.project-content { 
		flex-grow: 1; 
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	
	.project-content p { 
		margin: 0;
		line-height: 1.6; 
	}
	
	.project-content .description { 
		font-size: 1rem;
		color: #A8E7CC; 
		font-weight: 500; 
	}
	
	.project-content .details { 
		font-size: 0.95rem; 
		color: #A9B8AF; 
	}

	/* --- BOTONES --- */
	.project-links { 
		display: flex; 
		gap: 1rem; 
		margin-top: 1.5rem; 
	}
	
	.project-link { 
		flex: 1;
		text-align: center;
		padding: 0.8rem; 
		border-radius: 12px; 
		text-decoration: none; 
		font-weight: 600; 
		font-size: 0.95rem;
		transition: all 0.3s ease;
		cursor: pointer;
	}
	
	.project-link.primary { 
		background: #13A054; 
		color: #DAFFF0; 
		border: 1px solid #13A054; 
	}
	
	.project-link.primary:hover { 
		background: transparent; 
		color: #13A054;
	}

	/* --- PARTÍCULAS --- */
	.floating-particles { 
		position: absolute; 
		top: 0; 
		left: 0; 
		width: 100%; 
		height: 100%; 
		pointer-events: none; 
	}
	
	.particle { 
		position: absolute; 
		width: 6px; 
		height: 6px; 
		background: #13A054; 
		border-radius: 50%; 
		opacity: 0.4; 
	}
	
	/* --- MODAL --- */
	.coming-soon-modal {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.8); 
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		visibility: hidden;
		transition: all 0.3s ease;
		z-index: 9999;
		backdrop-filter: blur(5px);
	}

	.coming-soon-modal.show {
		opacity: 1;
		visibility: visible;
	}

	.coming-soon-content {
		width: min(450px, 90%);
		padding: 2.5rem 2rem;
		background: #0A2E1E; /* Dejé este fondo para el modal para que coincida con el tema general */
		border: 1px solid rgba(19, 160, 84, 0.4);
		border-radius: 24px;
		text-align: center;
		transform: translateY(20px);
		transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
	}

	.coming-soon-modal.show .coming-soon-content {
		transform: translateY(0);
	}

	.coming-soon-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.coming-soon-content h3 {
		color: #DAFFF0;
		font-size: 1.5rem;
		margin-bottom: 1rem;
		font-weight: 700;
	}

	.coming-soon-content p {
		color: #A9B8AF;
		line-height: 1.6;
		margin-bottom: 1.2rem;
		font-size: 0.95rem;
	}

	.close-modal-btn {
		background: #13A054;
		color: #DAFFF0;
		border: 1px solid #13A054;
		border-radius: 12px;
		padding: 0.8rem 2rem;
		font-weight: 600;
		font-size: 1rem;
		cursor: pointer;
		margin-top: 1rem;
		transition: all 0.3s ease;
		width: 100%;
	}

	.close-modal-btn:hover {
		background: transparent;
		color: #13A054;
	}

	/* --- RESPONSIVE --- */
	@media (max-width: 768px) { 
		.projects {
			padding: 4rem 1rem;
		}
		.projects-grid { 
			grid-template-columns: 1fr; 
		} 
		.projects h2 {
			font-size: 2.4rem;
		}
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const modal = document.getElementById('comingSoonModal');
		const closeBtn = document.getElementById('closeComingSoon');

		document.querySelectorAll('.coming-soon-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				modal?.classList.add('show');
			});
		});

		closeBtn?.addEventListener('click', () => {
			modal?.classList.remove('show');
		});

		modal?.addEventListener('click', (e) => {
			if (e.target === modal) {
				modal.classList.remove('show');
			}
		});
	});
</script>